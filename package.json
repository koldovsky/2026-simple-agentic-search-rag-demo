{
  "name": "its-devs-demo-hybrid-search-rag",
  "version": "0.1.0",
  "description": "Hybrid search RAG demo (console app)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "index": "node src/index.js index",
    "search": "node src/index.js search",
    "search:vector": "node src/index.js search --mode=vector",
    "search:keyword": "node src/index.js search --mode=keyword"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@langchain/textsplitters": "^1.0.2",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "openai": "^7.32.0",
    "stopword": "^3.1.5"
  }
}
